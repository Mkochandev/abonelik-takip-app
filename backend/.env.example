PORT=3000

# PostgreSQL bağlantı adresi (postgres://eriste_app:<şifre>@localhost:5432/eriste_dev).
# Geliştirmede SSH tüneliyle: localhost:5433.
DATABASE_URL=

# Access token (JWT, HS256) imza anahtarı. En az 32 karakter; üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Değişirse bütün access token'lar geçersiz olur (kullanıcılar refresh ile devam eder).
JWT_SECRET=

# Access token ömrü (saniye). Varsayılan 900 (15 dk); testte kısaltmak için.
ACCESS_TOKEN_TTL=

# Şifre sıfırlama bağlantısının kökü (…/sifre-sifirla?token=…). Varsayılan https://eriste.app
APP_BASE_URL=

# Resend API anahtarı (opsiyonel). Yoksa şifre sıfırlama e-postası gönderilmez,
# bağlantı loga yazılır (yalnızca geliştirme).
RESEND_API_KEY=
# Gönderen adres; Resend'de doğrulanmış alan adından olmalı. Varsayılan "erişte <noreply@eriste.app>".
MAIL_FROM=

# Ters vekil (nginx/caddy) ayarı; rate limit gerçek istemci IP'sini görsün.
# Varsayılan "loopback" (vekil aynı makinede). Vekil yoksa false.
TRUST_PROXY=

# Admin panel (backend/public/admin.html) için basit paylaşılan şifre.
# X-Admin-Secret header'ında bu değer bekleniyor.
ADMIN_SECRET=

# RevenueCat dashboard > Webhooks kısmında ayarlanan Authorization header
# değeriyle birebir aynı olmalı (POST /api/webhooks/revenuecat).
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat > Project settings > API keys > Secret key (REST API'den
# kullanıcının entitlement durumunu okumak ve hesap silinirken müşteriyi
# silmek için).
REVENUECAT_SECRET_KEY=

# Fiyat tarama servisi (backend/src/services/priceScanner.js) için.
ANTHROPIC_API_KEY=

# Otomatik fiyat taraması (Message Batches API, %50 ucuz). node-cron ifadesi,
# Europe/Istanbul saatiyle. Varsayılan "30 3 * * 1" (Pazartesi 03:30).
PRICE_SCAN_CRON=
# false ise otomatik tarama hiç kurulmaz (admin panelindeki "Fiyat tara" çalışır).
PRICE_SCAN_ENABLED=

# Logo.dev > Dashboard > Publishable key (pk_...). Admin panel logo
# önizlemesi için GET /api/admin/config üzerinden okunur.
LOGODEV_PUBLISHABLE_KEY=
