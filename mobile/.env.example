# Gerçek telefon (Expo Go) ile test ederken backend'e ulaşmak için
# bilgisayarının yerel ağ IP'sini buraya yaz (Windows'ta "ipconfig" ile bulunur).
# Android emulator veya web için genelde bu dosyaya gerek yok,
# src/api/client.js otomatik olarak 10.0.2.2 / localhost kullanır.
EXPO_PUBLIC_API_URL=http://192.168.1.34:3000

# RevenueCat > Project settings > API keys > Public app-specific key (iOS).
# Paywall/react-native-purchases yalnızca bu anahtar tanımlıysa (ve iOS'ta)
# çalışır; yoksa sessizce devre dışı kalır.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Logo.dev > Dashboard > Publishable key (pk_...). Servis logoları bu
# anahtarla yüklenir; yoksa baş harf karoları gösterilir.
EXPO_PUBLIC_LOGODEV_KEY=
